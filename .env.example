# Copy this file to .env for local development. Do not commit real secrets.

# Web app
NEXT_PUBLIC_FORGEFLOW_API_URL=http://localhost:8000

# API provider keys
NVIDIA_BUILD_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=

# Provider defaults
FORGEFLOW_DEFAULT_PROVIDER_STACK=local
FORGEFLOW_NVIDIA_KIMI_MODEL=moonshotai/kimi-k2.5
FORGEFLOW_NVIDIA_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
FORGEFLOW_NVIDIA_3D_MODEL=microsoft/trellis
FORGEFLOW_OPENROUTER_MODEL=minimax/minimax-m2.5:free
